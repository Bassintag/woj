{
  "name": "woj",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "packageManager": "bun",
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "FORCE_COLOR=3 bun run --cwd apps/api dev",
    "dev:web": "FORCE_COLOR=3 bun run --cwd apps/web dev",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "lefthook": "^2.2.2"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1"
  }
}
